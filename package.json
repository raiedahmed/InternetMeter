{
  "name": "internet-meter",
  "productName": "عدّاد الإنترنت",
  "version": "0.4.0",
  "description": "برنامج ويندوز لحساب استهلاك الإنترنت ومتابعة الباقة الشهرية",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "web": "vite",
    "start": "vite build && electron .",
    "build": "npm run dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dist": "npm run helper && vite build && electron-builder --win --publish never",
    "helper": "dotnet publish helper/NetTracker -c Release -o helper/bin"
  },
  "build": {
    "appId": "com.raied.internetmeter",
    "productName": "عدّاد الإنترنت",
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "عدّاد الإنترنت",
      "createDesktopShortcut": true,
      "artifactName": "InternetMeter-Setup-${version}.exe"
    },
    "directories": {
      "output": "release"
    },
    "executableName": "InternetMeter",
    "extraResources": [
      {
        "from": "helper/bin",
        "to": "helper",
        "filter": [
          "**/*"
        ]
      }
    ],
    "portable": {
      "artifactName": "InternetMeter-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "author": "raiedahmed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raiedahmed/InternetMeter.git"
  },
  "homepage": "https://github.com/raiedahmed/InternetMeter"
}
